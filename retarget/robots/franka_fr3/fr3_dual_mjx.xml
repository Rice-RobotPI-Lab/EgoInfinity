<mujoco model="fr3_dual_mjx">
  <!--
    MJX-compatible dual FR3.  Changes vs fr3_dual.xml:
      - No visual geoms (group 2) — reduces compile time and memory on GPU
      - Simplified box/sphere collision geoms instead of mesh colliders
      - position actuators use kp only (kv not supported in MJX < 3.2)
      - integrator="implicitfast", timestep=0.004
  -->
  <compiler angle="radian"/>

  <option integrator="implicitfast" timestep="0.004" iterations="4" ls_iterations="8"/>

  <default>
    <default class="fr3">
      <joint damping="0.21" armature="0.195" frictionloss="1.137"/>
      <position inheritrange="1"/>
    </default>
    <default class="gripper_finger">
      <joint axis="0 1 0" type="slide" range="0 0.04" damping="10" armature="0.1"/>
    </default>
  </default>

  <worldbody>

    <body name="base">

    <!-- ── Left arm  (y = +0.5) ─────────────────────────────────────────── -->
    <body name="left_base" pos="0 0.5 0" childclass="fr3">
      <body name="left_link0">
        <body name="left_link1" pos="0 0 0.333">
          <inertial pos="4.128e-07 -0.0181251 -0.0386036" quat="0.998098 -0.0605364 0.00380499 0.0110109"
            mass="2.92747" diaginertia="0.0239286 0.0227246 0.00610634"/>
          <joint name="left_joint1" axis="0 0 1" range="-2.7437 2.7437"/>
          <body name="left_link2" quat="1 -1 0 0">
            <inertial pos="0.00318289 -0.0743222 0.00881461" quat="0.502599 0.584437 -0.465998 0.434366"
              mass="2.93554" diaginertia="0.0629567 0.0411924 0.0246371"/>
            <joint name="left_joint2" axis="0 0 1" range="-1.7837 1.7837"/>
            <body name="left_link3" pos="0 -0.316 0" quat="1 1 0 0">
              <inertial pos="0.0407016 -0.00482006 -0.0289731" quat="0.921025 -0.244161 0.155272 0.260745"
                mass="2.2449" diaginertia="0.0267409 0.0189869 0.0171587"/>
              <joint name="left_joint3" axis="0 0 1" range="-2.9007 2.9007"/>
              <body name="left_link4" pos="0.0825 0 0" quat="1 1 0 0">
                <inertial pos="-0.0459101 0.0630493 -0.00851879" quat="0.438018 0.803311 0.00937812 0.403414"
                  mass="2.6156" diaginertia="0.05139 0.0372717 0.0160047"/>
                <joint name="left_joint4" axis="0 0 1" range="-3.0421 -0.1518"/>
                <body name="left_link5" pos="-0.0825 0.384 0" quat="1 -1 0 0">
                  <inertial pos="-0.00160396 0.0292536 -0.0972966" quat="0.919031 0.125604 0.0751531 -0.366003"
                    mass="2.32712" diaginertia="0.0579335 0.0449144 0.0130634"/>
                  <joint name="left_joint5" axis="0 0 1" range="-2.8065 2.8065"
                    armature="0.074" frictionloss="0.763"/>
                  <body name="left_link6" quat="1 1 0 0">
                    <inertial pos="0.0597131 -0.0410295 -0.0101693" quat="0.621301 0.552665 0.510011 0.220081"
                      mass="1.81704" diaginertia="0.0175039 0.0161123 0.00193529"/>
                    <joint name="left_joint6" axis="0 0 1" range="0.5445 4.5169"
                      armature="0.074" frictionloss="0.44"/>
                    <body name="left_link7" pos="0.088 0 0" quat="1 1 0 0">
                      <inertial pos="0.00452258 0.00862619 -0.0161633" quat="0.727579 0.0978688 -0.24906 0.63168"
                        mass="0.627143" diaginertia="0.000223836 0.000223642 5.64132e-07"/>
                      <joint name="left_joint7" axis="0 0 1" range="-3.0159 3.0159"
                        armature="0.074" frictionloss="0.248"/>
                      <body name="left_ee" pos="0 0 0.107" quat="-0.9238824 0 0 0.3826765"/>
                      <!-- ── Left Hand (MJX: primitives only) ────────────── -->
                      <body name="left_hand" pos="0 0 0.107" quat="0.9238795 0 0 -0.3826834">
                        <inertial mass="0.73" pos="-0.01 0 0.03" diaginertia="0.001 0.0025 0.0017"/>
                        <geom type="box" size="0.04 0.03 0.05" pos="0 0 0.035"/>
                        <site name="left_tcp" pos="0 0 0.1"/>
                        <body name="left_finger1" pos="0 0 0.0584">
                          <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
                          <joint name="left_finger_joint1" class="gripper_finger"/>
                          <geom type="box" size="0.008 0.004 0.03" pos="0 0.004 0.02"/>
                        </body>
                        <body name="left_finger2" pos="0 0 0.0584" quat="0 0 0 1">
                          <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
                          <joint name="left_finger_joint2" class="gripper_finger"/>
                          <geom type="box" size="0.008 0.004 0.03" pos="0 0.004 0.02"/>
                        </body>
                      </body>
                      <!-- ─────────────────────────────────────────────────── -->
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    <!-- ── Right arm  (y = -0.5) ─────────────────────────────────────────── -->
    <body name="right_base" pos="0 -0.5 0" childclass="fr3">
      <body name="right_link0">
        <body name="right_link1" pos="0 0 0.333">
          <inertial pos="4.128e-07 -0.0181251 -0.0386036" quat="0.998098 -0.0605364 0.00380499 0.0110109"
            mass="2.92747" diaginertia="0.0239286 0.0227246 0.00610634"/>
          <joint name="right_joint1" axis="0 0 1" range="-2.7437 2.7437"/>
          <body name="right_link2" quat="1 -1 0 0">
            <inertial pos="0.00318289 -0.0743222 0.00881461" quat="0.502599 0.584437 -0.465998 0.434366"
              mass="2.93554" diaginertia="0.0629567 0.0411924 0.0246371"/>
            <joint name="right_joint2" axis="0 0 1" range="-1.7837 1.7837"/>
            <body name="right_link3" pos="0 -0.316 0" quat="1 1 0 0">
              <inertial pos="0.0407016 -0.00482006 -0.0289731" quat="0.921025 -0.244161 0.155272 0.260745"
                mass="2.2449" diaginertia="0.0267409 0.0189869 0.0171587"/>
              <joint name="right_joint3" axis="0 0 1" range="-2.9007 2.9007"/>
              <body name="right_link4" pos="0.0825 0 0" quat="1 1 0 0">
                <inertial pos="-0.0459101 0.0630493 -0.00851879" quat="0.438018 0.803311 0.00937812 0.403414"
                  mass="2.6156" diaginertia="0.05139 0.0372717 0.0160047"/>
                <joint name="right_joint4" axis="0 0 1" range="-3.0421 -0.1518"/>
                <body name="right_link5" pos="-0.0825 0.384 0" quat="1 -1 0 0">
                  <inertial pos="-0.00160396 0.0292536 -0.0972966" quat="0.919031 0.125604 0.0751531 -0.366003"
                    mass="2.32712" diaginertia="0.0579335 0.0449144 0.0130634"/>
                  <joint name="right_joint5" axis="0 0 1" range="-2.8065 2.8065"
                    armature="0.074" frictionloss="0.763"/>
                  <body name="right_link6" quat="1 1 0 0">
                    <inertial pos="0.0597131 -0.0410295 -0.0101693" quat="0.621301 0.552665 0.510011 0.220081"
                      mass="1.81704" diaginertia="0.0175039 0.0161123 0.00193529"/>
                    <joint name="right_joint6" axis="0 0 1" range="0.5445 4.5169"
                      armature="0.074" frictionloss="0.44"/>
                    <body name="right_link7" pos="0.088 0 0" quat="1 1 0 0">
                      <inertial pos="0.00452258 0.00862619 -0.0161633" quat="0.727579 0.0978688 -0.24906 0.63168"
                        mass="0.627143" diaginertia="0.000223836 0.000223642 5.64132e-07"/>
                      <joint name="right_joint7" axis="0 0 1" range="-3.0159 3.0159"
                        armature="0.074" frictionloss="0.248"/>
                      <body name="right_ee" pos="0 0 0.107" quat="-0.9238824 0 0 0.3826765"/>
                      <!-- ── Right Hand (MJX: primitives only) ───────────── -->
                      <body name="right_hand" pos="0 0 0.107" quat="0.9238795 0 0 -0.3826834">
                        <inertial mass="0.73" pos="-0.01 0 0.03" diaginertia="0.001 0.0025 0.0017"/>
                        <geom type="box" size="0.04 0.03 0.05" pos="0 0 0.035"/>
                        <site name="right_tcp" pos="0 0 0.1"/>
                        <body name="right_finger1" pos="0 0 0.0584">
                          <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
                          <joint name="right_finger_joint1" class="gripper_finger"/>
                          <geom type="box" size="0.008 0.004 0.03" pos="0 0.004 0.02"/>
                        </body>
                        <body name="right_finger2" pos="0 0 0.0584" quat="0 0 0 1">
                          <inertial mass="0.015" pos="0 0 0" diaginertia="2.375e-6 2.375e-6 7.5e-7"/>
                          <joint name="right_finger_joint2" class="gripper_finger"/>
                          <geom type="box" size="0.008 0.004 0.03" pos="0 0.004 0.02"/>
                        </body>
                      </body>
                      <!-- ─────────────────────────────────────────────────── -->
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>

    </body> <!-- base -->

  </worldbody>

  <actuator>
    <position class="fr3" name="left_joint1"  joint="left_joint1"  kp="4500"/>
    <position class="fr3" name="left_joint2"  joint="left_joint2"  kp="4500"/>
    <position class="fr3" name="left_joint3"  joint="left_joint3"  kp="3500"/>
    <position class="fr3" name="left_joint4"  joint="left_joint4"  kp="3500"/>
    <position class="fr3" name="left_joint5"  joint="left_joint5"  kp="2000"/>
    <position class="fr3" name="left_joint6"  joint="left_joint6"  kp="2000"/>
    <position class="fr3" name="left_joint7"  joint="left_joint7"  kp="2000"/>
    <position class="fr3" name="right_joint1" joint="right_joint1" kp="4500"/>
    <position class="fr3" name="right_joint2" joint="right_joint2" kp="4500"/>
    <position class="fr3" name="right_joint3" joint="right_joint3" kp="3500"/>
    <position class="fr3" name="right_joint4" joint="right_joint4" kp="3500"/>
    <position class="fr3" name="right_joint5" joint="right_joint5" kp="2000"/>
    <position class="fr3" name="right_joint6" joint="right_joint6" kp="2000"/>
    <position class="fr3" name="right_joint7" joint="right_joint7" kp="2000"/>
    <position name="left_gripper"  joint="left_finger_joint1"  kp="350"
              ctrlrange="0 0.04" forcerange="-200 200"/>
    <position name="right_gripper" joint="right_finger_joint1" kp="350"
              ctrlrange="0 0.04" forcerange="-200 200"/>
  </actuator>

  <contact>
    <exclude body1="left_hand"  body2="left_finger1"/>
    <exclude body1="left_hand"  body2="left_finger2"/>
    <exclude body1="right_hand" body2="right_finger1"/>
    <exclude body1="right_hand" body2="right_finger2"/>
  </contact>

  <equality>
    <joint joint1="left_finger_joint1"  joint2="left_finger_joint2"  solimp="0.95 0.99 0.001" solref="0.005 1"/>
    <joint joint1="right_finger_joint1" joint2="right_finger_joint2" solimp="0.95 0.99 0.001" solref="0.005 1"/>
  </equality>

  <keyframe>
    <!-- qpos: 7 left arm + 2 left fingers + 7 right arm + 2 right fingers = 18 -->
    <!-- ctrl:  7 left arm + left gripper + 7 right arm + right gripper = 16 -->
    <key name="home"
      qpos="0 0 0 -1.57079 0 1.57079 -0.7853  0 0  0 0 0 -1.57079 0 1.57079 -0.7853  0 0"
      ctrl="0 0 0 -1.57079 0 1.57079 -0.7853  0    0 0 0 -1.57079 0 1.57079 -0.7853  0"/>
  </keyframe>
</mujoco>
